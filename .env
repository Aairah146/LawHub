# LawHub Backend Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration - LOCAL COMPASS
MONGODB_URI=mongodb://localhost:27017/lawhub

# JWT Configuration
JWT_SECRET=lawhub-secret-key-2025-super-secure
JWT_EXPIRE=7d

# CORS Configuration
